// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SystemRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  EMPLOYEE

  @@map("system_role")
}

enum UserStatus {
  ACTIVE
  LOCKED
  PENDING

  @@map("user_status")
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT

  @@map("task_priority")
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  BOOLEAN

  @@map("custom_field_type")
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("leave_request_status")
}

enum PersonnelProposalType {
  PROMOTION
  RAISE
  WARNING
  AWARD

  @@map("personnel_proposal_type")
}

enum PersonnelProposalStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("personnel_proposal_status")
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  config              TenantConfig?
  users               User[]
  roles               Role[]
  workflows           Workflow[]
  tasks               Task[]
  projects            Project[]
  customFields        CustomField[]
  bottleneckSnapshots BottleneckSnapshot[]
  notifications       Notification[]
  leaveRequests       LeaveRequest[]
  competencyProfiles  CompetencyProfile[]
  personnelProposals  PersonnelProposal[]
  employeeProfiles    EmployeeProfile[]

  @@map("tenants")
}

model TenantConfig {
  id        String   @id @default(uuid())
  tenantId  String   @unique @map("tenant_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Khung Settings (Giai đoạn 4) — Giai đoạn 5 (trọng số thuật toán) và Giai đoạn 7 (nội dung
  /// trang giới thiệu doanh nghiệp) sẽ thêm cột vào chung bảng này, không tạo bảng riêng.
  systemName        String? @map("system_name")
  primaryColor      String? @map("primary_color")
  logoUrl           String? @map("logo_url")
  enabledModules    Json    @default("[]") @map("enabled_modules")
  /// Trọng số Thuật toán 1 (gợi ý phân công) — 4 khoá cố định workload/onTimeRate/stepSpeed/
  /// returnRate, mặc định W1=0.30/W2=0.30/W3=0.25/W4=0.15 đúng tài liệu phân tích thiết kế Mục 4.4.
  assignmentWeights Json    @default("{\"workload\":0.3,\"onTimeRate\":0.3,\"stepSpeed\":0.25,\"returnRate\":0.15}") @map("assignment_weights")

  /// Giai đoạn 7 — nội dung trang giới thiệu doanh nghiệp public (Mục 4.8 tài liệu phân tích
  /// thiết kế), đọc qua GET /api/public/tenant/:slug (không cần JWT). `slug` dùng cho route này
  /// đã có sẵn trên `tenants` từ Giai đoạn 1, không thêm cột mới. bannerImages tối đa 5 phần tử —
  /// kiểm tra ở tầng Service khi upload, không ràng buộc DB. socialLinks dạng { facebook?,
  /// linkedin?, ... } tự do, không ép cứng danh sách nền tảng.
  introText    String? @map("intro_text")
  bannerImages Json    @default("[]") @map("banner_images")
  address      String?
  contactPhone String? @map("contact_phone")
  contactEmail String? @map("contact_email")
  socialLinks  Json    @default("{}") @map("social_links")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_config")
}

model User {
  id                 String     @id @default(uuid())
  tenantId           String?    @map("tenant_id")
  email              String     @unique
  passwordHash       String     @map("password_hash")
  fullName           String     @map("full_name")
  systemRole         SystemRole @map("system_role")
  status             UserStatus @default(ACTIVE)
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  tenant             Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles          UserRole[]
  assignedTasks      Task[]          @relation("TaskAssignee")
  taskHistoryItems   TaskHistory[]   @relation("TaskHistoryActionBy")
  projectMemberships ProjectMember[]
  notifications      Notification[]

  /// Giai đoạn 7 — 1 user có thể xuất hiện ở nhiều vai trò khác nhau trên cùng 1 bảng (người
  /// gửi/người duyệt đơn, người được đánh giá/người đánh giá, người được đề xuất/người tạo đề
  /// xuất/người phê duyệt) — mỗi vai trò 1 relation riêng, đặt tên rõ để Prisma không nhầm FK.
  leaveRequestsSubmitted     LeaveRequest[]      @relation("LeaveRequestUser")
  leaveRequestsReviewed      LeaveRequest[]      @relation("LeaveRequestReviewer")
  competencyProfiles         CompetencyProfile[] @relation("CompetencyProfileUser")
  competencyProfilesAuthored CompetencyProfile[] @relation("CompetencyProfileAuthor")
  personnelProposalsReceived PersonnelProposal[] @relation("PersonnelProposalUser")
  personnelProposalsProposed PersonnelProposal[] @relation("PersonnelProposalProposer")
  personnelProposalsReviewed PersonnelProposal[] @relation("PersonnelProposalReviewer")
  employeeProfile            EmployeeProfile?

  @@map("users")
}

model Role {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles UserRole[]

  @@unique([tenantId, name])
  @@map("roles")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model Workflow {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  states              WorkflowState[]
  transitions         WorkflowTransition[]
  projects            Project[]
  bottleneckSnapshots BottleneckSnapshot[]

  @@map("workflows")
}

model WorkflowState {
  id         String   @id @default(uuid())
  workflowId String   @map("workflow_id")
  name       String
  isStart    Boolean  @default(false) @map("is_start")
  isEnd      Boolean  @default(false) @map("is_end")
  isActive   Boolean  @default(true) @map("is_active")
  orderIndex Int      @default(0) @map("order_index")
  /// Toạ độ hiển thị trên canvas Workflow Builder — null nghĩa là chưa từng được kéo-thả, FE tự
  /// tính vị trí bằng auto-layout (xem computeInitialLayout ở frontend).
  positionX  Float?   @map("position_x")
  positionY  Float?   @map("position_y")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  workflow            Workflow             @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  outgoingTransitions WorkflowTransition[] @relation("FromState")
  incomingTransitions WorkflowTransition[] @relation("ToState")
  tasks               Task[]
  historyFrom         TaskHistory[]        @relation("HistoryFromState")
  historyTo           TaskHistory[]        @relation("HistoryToState")

  @@map("workflow_states")
}

model WorkflowTransition {
  id          String   @id @default(uuid())
  workflowId  String   @map("workflow_id")
  fromStateId String   @map("from_state_id")
  toStateId   String   @map("to_state_id")
  name        String
  allowRoles  Json     @default("[]") @map("allow_roles")
  condition   Json?    @map("condition")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workflow    Workflow      @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  fromState   WorkflowState @relation("FromState", fields: [fromStateId], references: [id], onDelete: Cascade)
  toState     WorkflowState @relation("ToState", fields: [toStateId], references: [id], onDelete: Cascade)
  taskHistory TaskHistory[]

  @@map("workflow_transitions")
}

model WorkflowTemplate {
  id          String   @id @default(uuid())
  name        String
  description String?
  /// Snapshot cấu trúc states+transitions dùng để clone khi import (Mục 3.10 CLAUDE.md).
  definition  Json
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("workflow_templates")
}

model Task {
  id                 String       @id @default(uuid())
  tenantId           String       @map("tenant_id")
  projectId          String       @map("project_id")
  title              String
  description        String?
  currentStateId     String       @map("current_state_id")
  assigneeId         String?      @map("assignee_id")
  priority           TaskPriority @default(MEDIUM)
  version            Int          @default(1)
  /// Hạn hoàn thành — dùng bởi Thuật toán 1 (tỷ lệ hoàn thành đúng hạn) và Thuật toán 2 (risk
  /// score). Task không có deadline không được tính risk_score (Giai đoạn 5, xem DECISIONS.md).
  deadline           DateTime?    @map("deadline")
  /// % nguy cơ trễ deadline (0-100), Thuật toán 2 cập nhật định kỳ — null nghĩa là chưa từng
  /// tính (task không có deadline, hoặc đã ở trạng thái is_end).
  riskScore          Float?       @map("risk_score")
  riskScoreUpdatedAt DateTime?    @map("risk_score_updated_at")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project           Project            @relation(fields: [projectId], references: [id])
  currentState      WorkflowState      @relation(fields: [currentStateId], references: [id])
  assignee          User?              @relation("TaskAssignee", fields: [assigneeId], references: [id])
  history           TaskHistory[]
  customFieldValues CustomFieldValue[]

  @@map("tasks")
}

model Project {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  workflowId String   @map("workflow_id")
  name       String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflow Workflow        @relation(fields: [workflowId], references: [id])
  members  ProjectMember[]
  tasks    Task[]

  @@map("projects")
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

/// Định nghĩa Custom Field theo tenant (Admin CRUD) — Mục "hướng mở rộng trong tương lai" ở
/// DECISIONS.md đã ghi rõ: scope theo Workflow là mở rộng sau, hiện tại field dùng chung tenant.
model CustomField {
  id           String          @id @default(uuid())
  tenantId     String          @map("tenant_id")
  name         String
  fieldType    CustomFieldType @map("field_type")
  isRequired   Boolean         @default(false) @map("is_required")
  defaultValue String?         @map("default_value")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  tenant Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  values CustomFieldValue[]

  @@unique([tenantId, name])
  @@map("custom_fields")
}

/// Giá trị lưu dạng text bất kể fieldType (TEXT/NUMBER/DATE/BOOLEAN) — chuẩn hoá/validate theo
/// đúng kiểu ở tầng Service khi ghi (Mục 3.5/3.6 CLAUDE.md: không xây rule engine tổng quát).
model CustomFieldValue {
  id            String   @id @default(uuid())
  taskId        String   @map("task_id")
  customFieldId String   @map("custom_field_id")
  value         String
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  task        Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  customField CustomField @relation(fields: [customFieldId], references: [id])

  @@unique([taskId, customFieldId])
  @@map("custom_field_values")
}

model TaskHistory {
  id           String   @id @default(uuid())
  taskId       String   @map("task_id")
  fromStateId  String?  @map("from_state_id")
  toStateId    String   @map("to_state_id")
  transitionId String?  @map("transition_id")
  actionBy     String   @map("action_by")
  actionAt     DateTime @default(now()) @map("action_at")
  comment      String?

  task         Task                @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fromState    WorkflowState?      @relation("HistoryFromState", fields: [fromStateId], references: [id])
  toState      WorkflowState       @relation("HistoryToState", fields: [toStateId], references: [id])
  transition   WorkflowTransition? @relation(fields: [transitionId], references: [id])
  actionByUser User                @relation("TaskHistoryActionBy", fields: [actionBy], references: [id])

  @@map("task_history")
}

/// Thuật toán 3 (bottleneck) — kết quả phân tích task_history định kỳ, lưu lại để Dashboard đọc
/// (Mục "Phạm vi" Giai đoạn 5 plan.md: "không cần tính realtime mỗi lần load trang"). Mỗi hàng là
/// 1 lần chạy job cho 1 Workflow; stateStats/transitionStats là mảng JSON (xem DECISIONS.md cho
/// cấu trúc phần tử) — không tách bảng con vì đây là dữ liệu chỉ-đọc cho Dashboard, không cần
/// query/join theo từng phần tử.
model BottleneckSnapshot {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  workflowId String   @map("workflow_id")
  computedAt DateTime @default(now()) @map("computed_at")
  windowDays Int      @default(30) @map("window_days")

  stateStats                  Json   @map("state_stats")
  transitionStats             Json   @map("transition_stats")
  overallBackwardRate         Float  @map("overall_backward_rate")
  deltaBackwardRateVsPrevious Float? @map("delta_backward_rate_vs_previous")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@map("bottleneck_snapshots")
}

/// Giai đoạn 6 — lưu lại notification để đọc khi offline (Mục "Phạm vi" plan.md: "lưu DB để đọc
/// lại khi offline"). `type` khớp đúng tên event Socket.io ở Mục "Quy ước Socket.io" plan.md
/// (`task:assigned`, `task:state-changed`, `task:risk-alert`) — `data` là phần `data` của cùng
/// payload đã gửi qua socket lúc phát sinh, không phải cấu trúc riêng, để FE dùng lại 1 component
/// render cho cả 2 nguồn (nhận realtime lẫn đọc lại từ API danh sách).
model Notification {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")
  type      String
  data      Json
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, isRead])
  @@map("notifications")
}

/// Giai đoạn 7 — đơn từ nội bộ (nghỉ phép, công tác...). File đính kèm tuỳ chọn, lưu Supabase
/// Storage (giới hạn 5MB, kiểm tra magic bytes — Mục "Giới hạn file upload" plan.md). Không có
/// khái niệm "quản lý trực tiếp" trong data model hiện tại (User không có managerId) nên MỌI
/// Manager/Admin trong tenant đều xem và duyệt được mọi đơn — giả định đơn giản nhất phù hợp
/// Mục 8 CLAUDE.md, ghi rõ trong DECISIONS.md. Duyệt xong bắn `leave-request:resolved` cho
/// người gửi, đúng event đã đặt tên sẵn ở Mục "Quy ước Socket.io" plan.md từ Giai đoạn 6.
model LeaveRequest {
  id            String             @id @default(uuid())
  tenantId      String             @map("tenant_id")
  userId        String             @map("user_id")
  startDate     DateTime           @map("start_date")
  endDate       DateTime           @map("end_date")
  reason        String
  attachmentUrl String?            @map("attachment_url")
  status        LeaveRequestStatus @default(PENDING)
  reviewedBy    String?            @map("reviewed_by")
  reviewedAt    DateTime?          @map("reviewed_at")
  reviewComment String?            @map("review_comment")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user     User   @relation("LeaveRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  reviewer User?  @relation("LeaveRequestReviewer", fields: [reviewedBy], references: [id])

  @@map("leave_requests")
}

/// Giai đoạn 7 — hồ sơ năng lực NỘI BỘ, chỉ Manager/Admin xem (Mục 4.3 tài liệu phân tích thiết
/// kế: "chỉ Manager mới thấy phần đánh giá nội bộ") — khác hẳn `employee_profiles` công khai bên
/// dưới. Mỗi hàng là 1 lượt đánh giá định tính theo kỳ do Manager ghi. Chỉ số định lượng tự động
/// (tổng task hoàn thành, tỷ lệ đúng hạn, thời gian xử lý trung bình...) KHÔNG lưu trùng ở đây —
/// tính trực tiếp từ task_history mỗi lần đọc (tái dùng TaskHistoryAnalyticsService của Giai
/// đoạn 5), tránh 1 dữ liệu có 2 nguồn có thể lệch nhau.
model CompetencyProfile {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  userId        String   @map("user_id")
  periodLabel   String   @map("period_label")
  overallRating Int      @map("overall_rating")
  managerNotes  String?  @map("manager_notes")
  createdBy     String   @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant        Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user          User   @relation("CompetencyProfileUser", fields: [userId], references: [id], onDelete: Cascade)
  createdByUser User   @relation("CompetencyProfileAuthor", fields: [createdBy], references: [id])

  @@map("competency_profiles")
}

/// Giai đoạn 7 — đề xuất nhân sự (Manager tạo, Admin phê duyệt/từ chối). Đúng "mức tối giản" mà
/// plan.md cho phép: quy trình 1 bước duy nhất (propose → resolve) — tài liệu phân tích thiết kế
/// gốc vốn dĩ chỉ mô tả 1 bước phê duyệt, không phải bị cắt bớt từ quy trình nhiều bước nào.
model PersonnelProposal {
  id            String                  @id @default(uuid())
  tenantId      String                  @map("tenant_id")
  userId        String                  @map("user_id")
  type          PersonnelProposalType
  description   String
  status        PersonnelProposalStatus @default(PENDING)
  proposedBy    String                  @map("proposed_by")
  reviewedBy    String?                 @map("reviewed_by")
  reviewedAt    DateTime?               @map("reviewed_at")
  reviewComment String?                 @map("review_comment")
  createdAt     DateTime                @default(now()) @map("created_at")
  updatedAt     DateTime                @updatedAt @map("updated_at")

  tenant         Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user           User   @relation("PersonnelProposalUser", fields: [userId], references: [id], onDelete: Cascade)
  proposedByUser User   @relation("PersonnelProposalProposer", fields: [proposedBy], references: [id])
  reviewer       User?  @relation("PersonnelProposalReviewer", fields: [reviewedBy], references: [id])

  @@map("personnel_proposals")
}

/// Giai đoạn 7 — hồ sơ CÔNG KHAI nhân viên (khác `competency_profiles` nội bộ ở trên). Employee
/// tự sửa qua PATCH /api/employee-profiles/me, mọi người trong tenant xem được qua GET
/// /api/employee-profiles/:userId. `completedTaskCount` không lưu ở đây — tính trực tiếp từ
/// task_history mỗi lần đọc, luôn khớp dữ liệu thật.
model EmployeeProfile {
  id             String   @id @default(uuid())
  userId         String   @unique @map("user_id")
  tenantId       String   @map("tenant_id")
  phone          String?
  address        String?
  bio            String?
  /// Mảng JSON { name, issuer, year } — Mục 3.5/3.6 CLAUDE.md: không xây bảng con cho dữ liệu
  /// chỉ đọc/ghi nguyên khối, không cần query riêng từng phần tử.
  certifications Json     @default("[]")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("employee_profiles")
}
