// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SystemRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  EMPLOYEE

  @@map("system_role")
}

enum UserStatus {
  ACTIVE
  LOCKED
  PENDING

  @@map("user_status")
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT

  @@map("task_priority")
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  BOOLEAN

  @@map("custom_field_type")
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  config       TenantConfig?
  users        User[]
  roles        Role[]
  workflows    Workflow[]
  tasks        Task[]
  projects     Project[]
  customFields CustomField[]

  @@map("tenants")
}

model TenantConfig {
  id        String   @id @default(uuid())
  tenantId  String   @unique @map("tenant_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Khung Settings (Giai đoạn 4) — Giai đoạn 5 (trọng số thuật toán) và Giai đoạn 7 (nội dung
  /// trang giới thiệu doanh nghiệp) sẽ thêm cột vào chung bảng này, không tạo bảng riêng.
  systemName      String? @map("system_name")
  primaryColor    String? @map("primary_color")
  logoUrl         String? @map("logo_url")
  enabledModules  Json    @default("[]") @map("enabled_modules")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_config")
}

model User {
  id                 String     @id @default(uuid())
  tenantId           String?    @map("tenant_id")
  email              String     @unique
  passwordHash       String     @map("password_hash")
  fullName           String     @map("full_name")
  systemRole         SystemRole @map("system_role")
  status             UserStatus @default(ACTIVE)
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  tenant             Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles          UserRole[]
  assignedTasks      Task[]          @relation("TaskAssignee")
  taskHistoryItems   TaskHistory[]   @relation("TaskHistoryActionBy")
  projectMemberships ProjectMember[]

  @@map("users")
}

model Role {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles UserRole[]

  @@unique([tenantId, name])
  @@map("roles")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model Workflow {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  states      WorkflowState[]
  transitions WorkflowTransition[]
  projects    Project[]

  @@map("workflows")
}

model WorkflowState {
  id         String   @id @default(uuid())
  workflowId String   @map("workflow_id")
  name       String
  isStart    Boolean  @default(false) @map("is_start")
  isEnd      Boolean  @default(false) @map("is_end")
  isActive   Boolean  @default(true) @map("is_active")
  orderIndex Int      @default(0) @map("order_index")
  /// Toạ độ hiển thị trên canvas Workflow Builder — null nghĩa là chưa từng được kéo-thả, FE tự
  /// tính vị trí bằng auto-layout (xem computeInitialLayout ở frontend).
  positionX  Float?   @map("position_x")
  positionY  Float?   @map("position_y")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  workflow            Workflow             @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  outgoingTransitions WorkflowTransition[] @relation("FromState")
  incomingTransitions WorkflowTransition[] @relation("ToState")
  tasks               Task[]
  historyFrom         TaskHistory[]        @relation("HistoryFromState")
  historyTo           TaskHistory[]        @relation("HistoryToState")

  @@map("workflow_states")
}

model WorkflowTransition {
  id          String   @id @default(uuid())
  workflowId  String   @map("workflow_id")
  fromStateId String   @map("from_state_id")
  toStateId   String   @map("to_state_id")
  name        String
  allowRoles  Json     @default("[]") @map("allow_roles")
  condition   Json?    @map("condition")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  workflow    Workflow      @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  fromState   WorkflowState @relation("FromState", fields: [fromStateId], references: [id], onDelete: Cascade)
  toState     WorkflowState @relation("ToState", fields: [toStateId], references: [id], onDelete: Cascade)
  taskHistory TaskHistory[]

  @@map("workflow_transitions")
}

model WorkflowTemplate {
  id          String   @id @default(uuid())
  name        String
  description String?
  /// Snapshot cấu trúc states+transitions dùng để clone khi import (Mục 3.10 CLAUDE.md).
  definition  Json
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("workflow_templates")
}

model Task {
  id             String       @id @default(uuid())
  tenantId       String       @map("tenant_id")
  projectId      String       @map("project_id")
  title          String
  description    String?
  currentStateId String       @map("current_state_id")
  assigneeId     String?      @map("assignee_id")
  priority       TaskPriority @default(MEDIUM)
  version        Int          @default(1)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project           Project            @relation(fields: [projectId], references: [id])
  currentState      WorkflowState      @relation(fields: [currentStateId], references: [id])
  assignee          User?              @relation("TaskAssignee", fields: [assigneeId], references: [id])
  history           TaskHistory[]
  customFieldValues CustomFieldValue[]

  @@map("tasks")
}

model Project {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  workflowId String   @map("workflow_id")
  name       String
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflow Workflow        @relation(fields: [workflowId], references: [id])
  members  ProjectMember[]
  tasks    Task[]

  @@map("projects")
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String   @map("project_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

/// Định nghĩa Custom Field theo tenant (Admin CRUD) — Mục "hướng mở rộng trong tương lai" ở
/// DECISIONS.md đã ghi rõ: scope theo Workflow là mở rộng sau, hiện tại field dùng chung tenant.
model CustomField {
  id           String          @id @default(uuid())
  tenantId     String          @map("tenant_id")
  name         String
  fieldType    CustomFieldType @map("field_type")
  isRequired   Boolean         @default(false) @map("is_required")
  defaultValue String?         @map("default_value")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  tenant Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  values CustomFieldValue[]

  @@unique([tenantId, name])
  @@map("custom_fields")
}

/// Giá trị lưu dạng text bất kể fieldType (TEXT/NUMBER/DATE/BOOLEAN) — chuẩn hoá/validate theo
/// đúng kiểu ở tầng Service khi ghi (Mục 3.5/3.6 CLAUDE.md: không xây rule engine tổng quát).
model CustomFieldValue {
  id            String   @id @default(uuid())
  taskId        String   @map("task_id")
  customFieldId String   @map("custom_field_id")
  value         String
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  task        Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  customField CustomField @relation(fields: [customFieldId], references: [id])

  @@unique([taskId, customFieldId])
  @@map("custom_field_values")
}

model TaskHistory {
  id           String   @id @default(uuid())
  taskId       String   @map("task_id")
  fromStateId  String?  @map("from_state_id")
  toStateId    String   @map("to_state_id")
  transitionId String?  @map("transition_id")
  actionBy     String   @map("action_by")
  actionAt     DateTime @default(now()) @map("action_at")
  comment      String?

  task         Task                @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fromState    WorkflowState?      @relation("HistoryFromState", fields: [fromStateId], references: [id])
  toState      WorkflowState       @relation("HistoryToState", fields: [toStateId], references: [id])
  transition   WorkflowTransition? @relation(fields: [transitionId], references: [id])
  actionByUser User                @relation("TaskHistoryActionBy", fields: [actionBy], references: [id])

  @@map("task_history")
}
