# Connection string PostgreSQL (Supabase) — Settings → Database → Connection string (URI)
DATABASE_URL=

# Cổng chạy backend cục bộ
PORT=3000

# URL frontend, dùng để cấu hình CORS
FRONTEND_URL=http://localhost:5173

# Chuỗi bí mật ký JWT — tự sinh 1 chuỗi ngẫu nhiên đủ dài, không dùng lại giá trị mẫu
JWT_SECRET=

# Supabase Storage (Giai đoạn 7 — upload ảnh banner, file đính kèm đơn từ). Lấy tại Supabase →
# Project Settings → API (Project URL + service_role key — KHÔNG phải anon key). Bucket tự tạo
# tại Supabase → Storage → New bucket, xem hướng dẫn chi tiết ở guide.md Phase 7.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=
